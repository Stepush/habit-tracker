{
  "name": "paper-first-habit-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:google": "node scripts/setup-google.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "sample:pdf": "node --import tsx scripts/generate-sample.ts",
    "format": "prettier --write src scripts tests next.config.ts package.json tsconfig.json"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "google-auth-library": "^11.3.2",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
