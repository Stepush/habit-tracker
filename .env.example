# Copy to .env.local. Never commit .env.local or downloaded Google key JSON.
# No trailing slash. Use this exact hostname when opening the tracker.
APP_URL=http://127.0.0.1:3000
# Generate locally: openssl rand -hex 32
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For first setup use 0, sign in, then replace with your verified googleSubject.
GOOGLE_OWNER_SUB=0
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep literal \n sequences from the downloaded key JSON, inside double quotes.
GOOGLE_PRIVATE_KEY=""
GOOGLE_SPREADSHEET_ID=
